<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_incense_option"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/imgItem"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Ảnh vật phẩm"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/priceLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_gold_counter"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/imgGoldIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="Vàng"
                android:src="@drawable/dollar" />

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="20"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Giữ viewSelected ẩn để tương thích an toàn nếu có nơi tham chiếu -->
    <View
        android:id="@+id/viewSelected"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>