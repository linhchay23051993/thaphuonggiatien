<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="135dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_incense_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/imgIncense"
            android:layout_width="50dp"
            android:layout_height="95dp"
            android:contentDescription="Ảnh nén hương"
            android:scaleType="fitCenter"
            android:src="@drawable/nen_huong_1" />

        <TextView
            android:id="@+id/txtIncenseName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:singleLine="true"
            android:text="1 nén thường"
            android:textColor="#5D4037"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtIncenseDesc"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Thành tâm kính cáo tổ tiên"
            android:textColor="#8D6E63"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/layoutPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_gold_counter"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="Vàng"
                android:src="@drawable/dollar" />

            <TextView
                android:id="@+id/txtIncensePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="5 Vàng"
                android:textColor="#D4AF37"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/imgCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Đã chọn"
        android:src="@drawable/ic_check_circle"
        android:visibility="invisible" />

</FrameLayout>
