<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.linhchay.thaphuonggiatien.ui.home.HomeFragment"
        android:label="Trang chủ"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_allEvents"
            app:destination="@+id/allEventsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/allEventsFragment"
        android:name="com.linhchay.thaphuonggiatien.ui.home.AllEventsFragment"
        android:label="Tất Cả Sự Kiện"
        tools:layout="@layout/fragment_all_events" />

    <fragment
        android:id="@+id/navigation_ancestor"
        android:name="com.linhchay.thaphuonggiatien.ui.ancestor.AncestorFragment"
        android:label="Gia Tiên"
        tools:layout="@layout/fragment_ancestor" />

    <!-- Nested graph: BottomNav sẽ highlight tab Đền Chùa cho mọi destination bên trong -->
    <navigation
        android:id="@+id/navigation_temple"
        app:startDestination="@+id/templeListFragment">

        <fragment
            android:id="@+id/templeListFragment"
            android:name="com.linhchay.thaphuonggiatien.ui.temple.TempleFragment"
            android:label="Đền Chùa"
            tools:layout="@layout/fragment_temple">
            <action
                android:id="@+id/action_navigation_temple_to_templeAltarFragment"
                app:destination="@id/templeAltarFragment" />
        </fragment>

        <fragment
            android:id="@+id/templeAltarFragment"
            android:name="com.linhchay.thaphuonggiatien.ui.temple.TempleAltarFragment"
            android:label="Dâng Lễ Đền Chùa"
            tools:layout="@layout/fragment_temple_altar" />
    </navigation>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.linhchay.thaphuonggiatien.ui.profile.ProfileFragment"
        android:label="Cá Nhân"
        tools:layout="@layout/fragment_profile" />
</navigation>